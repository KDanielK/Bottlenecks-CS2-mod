<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
	
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
	</PropertyGroup>
	
	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<PropertyGroup>
		<!--Do not embed the (private) GitHub repository URL in the debug info-->
		<EnableSourceLink>false</EnableSourceLink>
	</PropertyGroup>

	<!--Debug files are only for local debugging: keep them in bin, but never deploy/publish them.
	They contain local build paths (Windows user name).-->
	<Target Name="RemoveDebugFilesFromDeploy" AfterTargets="DeployWIP">
		<ItemGroup>
			<DeployedDebugFiles Include="$(DeployDir)\**\*.pdb" />
		</ItemGroup>
		<Delete Files="@(DeployedDebugFiles)" />
	</Target>

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.PSI.Common">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.ImageConversionModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Icons\TrainBlocked.png">
			<LogicalName>Bottlenecks.Icons.TrainBlocked.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icons\TrainQueued.png">
			<LogicalName>Bottlenecks.Icons.TrainQueued.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icons\TrainDespawned.png">
			<LogicalName>Bottlenecks.Icons.TrainDespawned.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icons\CargoNotSelling.png">
			<LogicalName>Bottlenecks.Icons.CargoNotSelling.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icons\CargoOverloaded.png">
			<LogicalName>Bottlenecks.Icons.CargoOverloaded.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icons\CargoBacklogged.png">
			<LogicalName>Bottlenecks.Icons.CargoBacklogged.png</LogicalName>
		</EmbeddedResource>
		<None Remove="Icons\*.svg" />
	</ItemGroup>

</Project>
